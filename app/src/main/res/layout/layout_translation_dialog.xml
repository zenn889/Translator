<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dialogRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_hud_modern"
    android:padding="16dp"
    android:layout_marginStart="12dp"
    android:layout_marginEnd="12dp"
    android:layout_marginBottom="16dp"
    android:elevation="20dp">

    <!-- Center Drag Handle Indicator -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_drag_handle"
        android:layout_marginBottom="10dp" />

    <!-- Top Header & Action Bar -->
    <LinearLayout
        android:id="@+id/dialogDragHandle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="8dp">

        <!-- Title & Language Pill -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="GAMETRANS HUD SUBTITLE"
                android:textColor="#38bdf8"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <TextView
                android:id="@+id/tvLangPairBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="JA ➔ ID"
                android:textColor="#94a3b8"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Font Size Cycle Button -->
        <ImageButton
            android:id="@+id/btnFontSize"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:padding="8dp"
            android:background="@drawable/bg_button_circle"
            android:src="@drawable/ic_font_size"
            android:contentDescription="Ubah Ukuran Teks"
            android:layout_marginEnd="6dp" />

        <!-- Text-to-Speech Voice Button -->
        <ImageButton
            android:id="@+id/btnTts"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:padding="8dp"
            android:background="@drawable/bg_button_circle"
            android:src="@drawable/ic_speaker"
            android:contentDescription="Suara"
            android:layout_marginEnd="6dp" />

        <!-- Copy to Clipboard Button -->
        <ImageButton
            android:id="@+id/btnCopy"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:padding="8dp"
            android:background="@drawable/bg_button_circle"
            android:src="@drawable/ic_copy"
            android:contentDescription="Salin"
            android:layout_marginEnd="6dp" />

        <!-- Close Dialog Button -->
        <ImageButton
            android:id="@+id/btnClose"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:padding="8dp"
            android:background="@drawable/bg_button_circle"
            android:src="@drawable/ic_close"
            android:contentDescription="@string/close" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#1a38bdf8"
        android:layout_marginBottom="10dp" />

    <!-- Subtitle Card Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_subtitle_box"
        android:padding="12dp">

        <!-- Indonesian Translated Subtitle (High Contrast Game Yellow) -->
        <TextView
            android:id="@+id/tvTranslated"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/translating"
            android:textColor="#fde047"
            android:textSize="20sp"
            android:textStyle="bold"
            android:lineSpacingExtra="5dp"
            android:shadowColor="#000000"
            android:shadowDx="0"
            android:shadowDy="3"
            android:shadowRadius="6" />

    </LinearLayout>

    <!-- Original Recognized Game Text (Muted italic) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="8dp"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TEKS ASLI:"
            android:textColor="#64748b"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvOriginal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text=""
            android:textColor="#94a3b8"
            android:textSize="12sp"
            android:textStyle="italic" />
    </LinearLayout>

</LinearLayout>
