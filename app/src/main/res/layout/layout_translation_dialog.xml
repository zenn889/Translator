<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dialogRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_hud"
    android:padding="16dp"
    android:layout_margin="16dp"
    android:elevation="12dp">

    <!-- Top Action Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="GAMETRANS HUD SUBTITLE"
            android:textColor="#38bdf8"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.05" />

        <!-- Text-to-Speech Voice Button -->
        <ImageButton
            android:id="@+id/btnTts"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_speaker"
            android:contentDescription="Suara"
            android:layout_marginEnd="6dp" />

        <!-- Copy to Clipboard Button -->
        <ImageButton
            android:id="@+id/btnCopy"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_copy"
            android:contentDescription="Salin"
            android:layout_marginEnd="6dp" />

        <!-- Close Dialog Button -->
        <ImageButton
            android:id="@+id/btnClose"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_close"
            android:contentDescription="@string/close" />
    </LinearLayout>

    <!-- Indonesian Translated Subtitle (Prominent, High Contrast Yellow) -->
    <TextView
        android:id="@+id/tvTranslated"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/translating"
        android:textColor="#fde047"
        android:textSize="18sp"
        android:textStyle="bold"
        android:lineSpacingExtra="3dp"
        android:shadowColor="#000000"
        android:shadowDx="0"
        android:shadowDy="2"
        android:shadowRadius="4" />

    <!-- Original Recognized Text (Muted italic) -->
    <TextView
        android:id="@+id/tvOriginal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text=""
        android:textColor="#94a3b8"
        android:textSize="13sp"
        android:textStyle="italic" />

</LinearLayout>
